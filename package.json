{
  "name": "boardgame-affinity",
  "version": "0.1.0",
  "private": true,
  "description": "Explorateur de jeux de société par ressemblance (données BoardGameGeek) : interface web statique + pipeline Python.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "python3 web/serve.py 8765",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json && eslint . && prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test 'tests/unit/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:real": "E2E_REAL_DATA=1 playwright test",
    "fixture": "node tests/fixtures/make-small.mjs",
    "baseline": "E2E_REAL_DATA=1 playwright test tests/e2e/baseline.spec.js --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
